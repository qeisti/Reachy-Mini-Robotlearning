# Destilliertes FunctionGemma (270M) fuer Reachy Mini, v2: ein Tool pro Aktion, Regeln aus
# rule_based.py durchgesetzt (dataset.jsonl). Lehrer fuer freie Sprache: qwen2.5:14b
#
#   python ~/llama.cpp/convert_hf_to_gguf.py experiments/distill/model_v2/final \
#       --outtype q8_0 --outfile experiments/distill/reachy-fg.gguf
#   ollama create reachy-fg -f experiments/distill/Modelfile
#
# RENDERER/PARSER sind entscheidend: ohne sie baut Ollama den Prompt anders als im
# Training (scripts/distill_format.py) und erkennt keine Tool-Aufrufe.
FROM ./reachy-fg.gguf
RENDERER functiongemma
PARSER functiongemma
PARAMETER top_k 64
PARAMETER top_p 0.95
# FunctionGemma beendet einen Tool-Aufruf mit <start_function_response> (eos_token_id 50).
# Ollama stoppt dort nicht von selbst -> das Modell wiederholt den Aufruf bis num_predict
# (128 statt ~25 Tokens, auf dem CM4 mehrere Sekunden). Betrifft auch das Original-functiongemma.
PARAMETER stop <start_function_response>
PARAMETER stop <end_of_turn>
